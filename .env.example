# --- Proveedor de modelo de lenguaje ---------------------------------------
# anthropic | openai   (openai también sirve para cualquier endpoint
#                        compatible con OpenAI: Groq, Mistral, Ollama, OpenRouter…)
LLM_PROVIDER=anthropic

# La clave NUNCA se versiona: solo vive en esta variable de entorno del backend.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelo a usar (ajústalo al que tu clave tenga disponible)
LLM_MODEL=claude-sonnet-4-5

# Solo si usas un endpoint compatible con OpenAI (opcional)
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Límites de costo y robustez -------------------------------------------
# Tope de iteraciones herramienta → modelo por turno (regla CA1)
LLM_MAX_ITERACIONES=25
# Timeout contra el proveedor en milisegundos
LLM_TIMEOUT_MS=60000
# Tope aproximado de tokens por sesión (evita que un usuario gaste sin límite)
LLM_MAX_TOKENS_SESION=200000

# --- Servidor ----------------------------------------------------------------
PORT=8787
